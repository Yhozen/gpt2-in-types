{
  "name": "gpt2-in-types",
  "version": "0.0.0",
  "private": true,
  "description": "A GPT-2-style language model that runs inside the TypeScript type checker: hover a type, get a story.",
  "homepage": "https://github.com/Yhozen/gpt2-in-types#readme",
  "bugs": {
    "url": "https://github.com/Yhozen/gpt2-in-types/issues"
  },
  "license": "MIT",
  "author": "Gabriel Perez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yhozen/gpt2-in-types.git"
  },
  "type": "module",
  "scripts": {
    "train": "uv run scripts/train.py",
    "compile": "node scripts/compile.ts && node scripts/gen-engine-tests.ts && node scripts/generate.ts \"Once upon a time\" 24 --out examples/story.ts",
    "generate": "node scripts/generate.ts",
    "hover": "node scripts/hover.ts",
    "check:hover": "node scripts/check-hover.ts",
    "parity": "uv run scripts/parity.py && node scripts/parity.ts",
    "examples": "tsrs -p examples --fast",
    "test": "vp test",
    "typecheck": "tsrs --noEmit --fast",
    "check": "vp check && tsrs --noEmit --fast",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
