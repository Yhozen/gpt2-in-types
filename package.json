{
  "name": "gpt2-in-types",
  "version": "0.0.0",
  "private": true,
  "description": "GPT-2 running inside the TypeScript type checker.",
  "homepage": "https://github.com/Yhozen/gpt2-in-types#readme",
  "bugs": {
    "url": "https://github.com/Yhozen/gpt2-in-types/issues"
  },
  "license": "MIT",
  "author": "Gabriel Perez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yhozen/gpt2-in-types.git"
  },
  "type": "module",
  "scripts": {
    "train": "uv run scripts/train.py",
    "export": "node scripts/export.ts",
    "codegen": "node scripts/gen-tables.ts && node scripts/gen-op-tests.ts",
    "generate": "node scripts/generate.ts",
    "examples": "tsrs -p examples --fast",
    "test": "vp test",
    "typecheck": "tsrs --noEmit --fast",
    "check": "vp check && tsrs --noEmit --fast",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
